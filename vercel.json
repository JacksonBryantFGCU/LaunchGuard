{
  "buildCommand": "pnpm --filter web run build && node scripts/bundle-api.mjs",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|health).*)", "destination": "/index.html" }
  ]
}
