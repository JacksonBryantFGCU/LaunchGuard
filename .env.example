NODE_ENV=development

API_PORT=3001

WEB_ORIGIN=http://localhost:5173

VITE_API_URL=http://localhost:3001

# Server-only. Never expose an ElevenLabs API key to the browser (no VITE_ prefix).
ELEVENLABS_API_KEY=
# ID of the reusable ElevenLabs ConvAI agent configured for Redline's architect persona.
ELEVENLABS_AGENT_ID=

# Clerk (see Clerk Dashboard > API Keys). Frontend key is public by design;
# secret key is server-only and must never carry a VITE_ prefix.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (server-only - see apps/api/src/db/supabase.ts). Use the current
# Supabase secret key (sb_secret_...), not the legacy service_role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=